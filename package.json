{
  "displayName": "Homebridge Anthem Receiver",
  "name": "homebridge-anthemreceiver",
  "version": "0.8.6",
  "description": "Homebridge integration for Anthem AV receiver.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pponce/homebridge-anthemreceiver.git"
  },
  "bugs": {
    "url": "https://github.com/pponce/homebridge-anthemreceiver/issues"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.0 || ^2.0.0-0",
    "node": "^18.20.4 || ^20.15.1 || ^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "tsc --noEmit && node scripts/check-source.cjs",
    "watch": "npm run build && npm link && nodemon",
    "build": "node scripts/build.cjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run check:package",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:ui": "node --test test/ui.browser.cjs",
    "check:package": "node scripts/check-package.cjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0-beta.0 || ^2.0.0-0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "playwright": "^1.56.1"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
